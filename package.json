{
  "name": "@iamsuosi/dsh-remotion-studio",
  "version": "0.1.0",
  "description": "Agent-first Remotion video studio for DeepSeek Harness: plan, render and edit promo videos from a structured case.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "templates",
    "studio",
    "scripts",
    "cases",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render": "node scripts/remotion.mjs",
    "test": "npm run build && node test/tools.test.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "plugin",
    "remotion",
    "video",
    "promo",
    "agent"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@remotion/cli": "4.0.409",
    "remotion": "4.0.409",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.3.0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsuosi/dsh-remotion-studio.git"
  },
  "bugs": {
    "url": "https://github.com/iamsuosi/dsh-remotion-studio/issues"
  },
  "homepage": "https://github.com/iamsuosi/dsh-remotion-studio#readme",
  "author": "iamsuosi"
}
